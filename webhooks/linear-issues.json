{
  "name": "linear-issues",
  "auth": {
    "auth_type": "none"
  },
  "target": {
    "target_type": "fixed_sandbox_name",
    "sandbox_name": "linear-issues"
  },
  "idempotency": {
    "source": "header",
    "name": "Linear-Delivery"
  },
  "status": "active",
  "rules": [
    {
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "equals",
            "json_path": "$.action",
            "value": "update"
          },
          {
            "op": "exists",
            "json_path": "$.updatedFrom.labelIds"
          },
          {
            "op": "contains",
            "json_path": "$.data.labelIds",
            "value": "90399f02-187d-4608-b269-abf3c75b7778"
          },
          {
            "op": "not",
            "condition": {
              "op": "contains",
              "json_path": "$.updatedFrom.labelIds",
              "value": "90399f02-187d-4608-b269-abf3c75b7778"
            }
          }
        ]
      },
      "actions": [
        {
          "action_type": "trigger_job",
          "job_name": "linear-implementor",
          "params": {
            "issue_id": {
              "source": {
                "source": "json_path",
                "path": "$.data.id"
              }
            },
            "issue_title": {
              "source": {
                "source": "json_path",
                "path": "$.data.title"
              }
            },
            "issue_description": {
              "source": {
                "source": "json_path",
                "path": "$.data.description"
              }
            },
            "issue_identifier": {
              "source": {
                "source": "json_path",
                "path": "$.data.identifier"
              }
            },
            "issue_url": {
              "source": {
                "source": "json_path",
                "path": "$.url"
              }
            }
          }
        }
      ]
    }
  ]
}
