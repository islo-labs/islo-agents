{
  "name": "github-events",
  "auth": {
    "auth_type": "none"
  },
  "target": {
    "target_type": "fixed_sandbox_name",
    "sandbox_name": "github-events"
  },
  "idempotency": {
    "source": "header",
    "name": "X-GitHub-Delivery"
  },
  "status": "active",
  "rules": [
    {
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "equals",
            "json_path": "$.action",
            "value": "completed"
          },
          {
            "op": "equals",
            "json_path": "$.workflow_run.conclusion",
            "value": "failure"
          },
          {
            "op": "equals",
            "json_path": "$.workflow_run.event",
            "value": "pull_request"
          },
          {
            "op": "any",
            "conditions": [
              {
                "op": "equals",
                "json_path": "$.workflow_run.name",
                "value": "CI"
              }
            ]
          }
        ]
      },
      "actions": [
        {
          "action_type": "trigger_job",
          "job_name": "islo-babysit",
          "params": {
            "repo": {
              "source": {
                "source": "json_path",
                "path": "$.repository.full_name"
              }
            },
            "repo_name": {
              "source": {
                "source": "json_path",
                "path": "$.repository.name"
              }
            },
            "workflow_run_id": {
              "parts": [
                {
                  "type": "source",
                  "source": {
                    "source": "json_path",
                    "path": "$.workflow_run.id"
                  }
                }
              ]
            },
            "head_ref": {
              "source": {
                "source": "json_path",
                "path": "$.workflow_run.head_branch"
              }
            },
            "head_repository": {
              "source": {
                "source": "json_path",
                "path": "$.workflow_run.head_repository.full_name"
              }
            }
          }
        }
      ]
    },
    {
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "equals",
            "json_path": "$.action",
            "value": "created"
          },
          {
            "op": "any",
            "conditions": [
              {
                "op": "exists",
                "json_path": "$.issue.pull_request"
              },
              {
                "op": "exists",
                "json_path": "$.pull_request"
              }
            ]
          },
          {
            "op": "matches",
            "json_path": "$.comment.body",
            "pattern": "(?i)@islo"
          }
        ]
      },
      "actions": [
        {
          "action_type": "trigger_job",
          "job_name": "delegator",
          "params": {
            "source": {
              "parts": [
                {
                  "type": "literal",
                  "value": "github"
                }
              ]
            },
            "event_type": {
              "parts": [
                {
                  "type": "literal",
                  "value": "github_pr_comment"
                }
              ]
            },
            "raw_payload": {
              "source": {
                "source": "raw_body"
              }
            },
            "delivery_id": {
              "source": {
                "source": "header",
                "name": "X-GitHub-Delivery"
              }
            }
          }
        }
      ]
    },
    {
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "exists",
            "json_path": "$.pull_request"
          },
          {
            "op": "equals",
            "json_path": "$.action",
            "value": "opened"
          }
        ]
      },
      "actions": [
        {
          "action_type": "trigger_job",
          "job_name": "islo-review",
          "params": {
            "repo": {
              "source": {
                "source": "json_path",
                "path": "$.repository.full_name"
              }
            },
            "repo_name": {
              "source": {
                "source": "json_path",
                "path": "$.repository.name"
              }
            },
            "pr_number": {
              "source": {
                "source": "json_path",
                "path": "$.pull_request.number"
              }
            },
            "head_ref": {
              "source": {
                "source": "json_path",
                "path": "$.pull_request.head.ref"
              }
            },
            "base_ref": {
              "source": {
                "source": "json_path",
                "path": "$.pull_request.base.ref"
              }
            }
          }
        }
      ]
    },
    {
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "exists",
            "json_path": "$.pull_request"
          },
          {
            "op": "equals",
            "json_path": "$.action",
            "value": "reopened"
          }
        ]
      },
      "actions": [
        {
          "action_type": "trigger_job",
          "job_name": "islo-review",
          "params": {
            "repo": {
              "source": {
                "source": "json_path",
                "path": "$.repository.full_name"
              }
            },
            "repo_name": {
              "source": {
                "source": "json_path",
                "path": "$.repository.name"
              }
            },
            "pr_number": {
              "source": {
                "source": "json_path",
                "path": "$.pull_request.number"
              }
            },
            "head_ref": {
              "source": {
                "source": "json_path",
                "path": "$.pull_request.head.ref"
              }
            },
            "base_ref": {
              "source": {
                "source": "json_path",
                "path": "$.pull_request.base.ref"
              }
            }
          }
        }
      ]
    },
    {
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "exists",
            "json_path": "$.pull_request"
          },
          {
            "op": "equals",
            "json_path": "$.label.name",
            "value": "islo-review"
          }
        ]
      },
      "actions": [
        {
          "action_type": "trigger_job",
          "job_name": "islo-review",
          "params": {
            "repo": {
              "source": {
                "source": "json_path",
                "path": "$.repository.full_name"
              }
            },
            "repo_name": {
              "source": {
                "source": "json_path",
                "path": "$.repository.name"
              }
            },
            "pr_number": {
              "source": {
                "source": "json_path",
                "path": "$.pull_request.number"
              }
            },
            "head_ref": {
              "source": {
                "source": "json_path",
                "path": "$.pull_request.head.ref"
              }
            },
            "base_ref": {
              "source": {
                "source": "json_path",
                "path": "$.pull_request.base.ref"
              }
            }
          }
        }
      ]
    },
    {
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "exists",
            "json_path": "$.pull_request"
          },
          {
            "op": "equals",
            "json_path": "$.label.name",
            "value": "islo-verify"
          }
        ]
      },
      "actions": [
        {
          "action_type": "trigger_job",
          "job_name": "islo-verify",
          "params": {
            "repo": {
              "source": {
                "source": "json_path",
                "path": "$.repository.full_name"
              }
            },
            "repo_name": {
              "source": {
                "source": "json_path",
                "path": "$.repository.name"
              }
            },
            "pr_number": {
              "source": {
                "source": "json_path",
                "path": "$.pull_request.number"
              }
            },
            "head_ref": {
              "source": {
                "source": "json_path",
                "path": "$.pull_request.head.ref"
              }
            },
            "base_ref": {
              "source": {
                "source": "json_path",
                "path": "$.pull_request.base.ref"
              }
            },
            "pr_title": {
              "source": {
                "source": "json_path",
                "path": "$.pull_request.title"
              }
            }
          }
        }
      ]
    }
  ]
}
