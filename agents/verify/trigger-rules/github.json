[
  {
    "when": {
      "op": "all",
      "conditions": [
        { "op": "exists", "json_path": "$.pull_request" },
        { "op": "equals", "json_path": "$.label.name", "value": "islo-verify" }
      ]
    },
    "actions": [
      {
        "action_type": "trigger_job",
        "job_name": "islo-verify",
        "params": {
          "repo": {
            "source": { "source": "json_path", "path": "$.repository.full_name" }
          },
          "repo_name": {
            "source": { "source": "json_path", "path": "$.repository.name" }
          },
          "pr_number": {
            "source": { "source": "json_path", "path": "$.pull_request.number" }
          },
          "head_ref": {
            "source": { "source": "json_path", "path": "$.pull_request.head.ref" }
          },
          "base_ref": {
            "source": { "source": "json_path", "path": "$.pull_request.base.ref" }
          },
          "pr_title": {
            "source": { "source": "json_path", "path": "$.pull_request.title" }
          }
        }
      }
    ]
  }
]
