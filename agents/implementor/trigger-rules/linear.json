[
  {
    "when": {
      "op": "all",
      "conditions": [
        { "op": "equals", "json_path": "$.action", "value": "update" },
        { "op": "exists", "json_path": "$.updatedFrom.labelIds" },
        { "op": "contains", "json_path": "$.data.labelIds", "value": "REPLACE_WITH_YOUR_LINEAR_LABEL_ID" },
        { "op": "not", "condition": {
          "op": "contains",
          "json_path": "$.updatedFrom.labelIds",
          "value": "REPLACE_WITH_YOUR_LINEAR_LABEL_ID"
        }}
      ]
    },
    "actions": [
      {
        "action_type": "trigger_job",
        "job_name": "linear-implementor",
        "params": {
          "issue_id": { "source": { "source": "json_path", "path": "$.data.id" } },
          "issue_title": { "source": { "source": "json_path", "path": "$.data.title" } },
          "issue_description": { "source": { "source": "json_path", "path": "$.data.description" } },
          "issue_identifier": { "source": { "source": "json_path", "path": "$.data.identifier" } },
          "issue_url": { "source": { "source": "json_path", "path": "$.url" } }
        }
      }
    ]
  }
]
