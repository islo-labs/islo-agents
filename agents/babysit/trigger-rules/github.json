[
  {
    "when": {
      "op": "all",
      "conditions": [
        { "op": "equals", "json_path": "$.action", "value": "completed" },
        { "op": "equals", "json_path": "$.workflow_run.conclusion", "value": "failure" },
        { "op": "equals", "json_path": "$.workflow_run.event", "value": "pull_request" }
      ]
    },
    "actions": [
      {
        "action_type": "trigger_job",
        "job_name": "islo-babysit",
        "params": {
          "repo": {
            "source": { "source": "json_path", "path": "$.repository.full_name" }
          },
          "repo_name": {
            "source": { "source": "json_path", "path": "$.repository.name" }
          },
          "workflow_run_id": {
            "parts": [
              {
                "type": "source",
                "source": { "source": "json_path", "path": "$.workflow_run.id" }
              }
            ]
          },
          "head_repository": {
            "source": {
              "source": "json_path",
              "path": "$.workflow_run.head_repository.full_name"
            }
          }
        }
      }
    ]
  }
]
