[
  {
    "when": {
      "op": "all",
      "conditions": [
        { "op": "equals", "json_path": "$.action", "value": "completed" },
        { "op": "equals", "json_path": "$.workflow_run.conclusion", "value": "failure" },
        { "op": "equals", "json_path": "$.workflow_run.event", "value": "pull_request" },
        {
          "op": "any",
          "conditions": [
            { "op": "equals", "json_path": "$.workflow_run.name", "value": "CI" },
            { "op": "equals", "json_path": "$.workflow_run.name", "value": "Test" },
            { "op": "equals", "json_path": "$.workflow_run.name", "value": "Build" },
            { "op": "equals", "json_path": "$.workflow_run.name", "value": "PR Title Lint" },
            { "op": "equals", "json_path": "$.workflow_run.name", "value": "Terraform Validate" },
            { "op": "equals", "json_path": "$.workflow_run.name", "value": "Ansible" },
            { "op": "equals", "json_path": "$.workflow_run.name", "value": "Lint, Format, and Unit Tests" },
            { "op": "equals", "json_path": "$.workflow_run.name", "value": "Storybook Tests" }
          ]
        }
      ]
    },
    "actions": [
      {
        "action_type": "trigger_job",
        "job_name": "islo-babysit",
        "params": {
          "repo": {
            "source": { "source": "json_path", "path": "$.repository.full_name" }
          },
          "repo_name": {
            "source": { "source": "json_path", "path": "$.repository.name" }
          },
          "workflow_run_id": {
            "parts": [
              {
                "type": "source",
                "source": { "source": "json_path", "path": "$.workflow_run.id" }
              }
            ]
          },
          "head_ref": {
            "source": { "source": "json_path", "path": "$.workflow_run.head_branch" }
          },
          "head_repository": {
            "source": {
              "source": "json_path",
              "path": "$.workflow_run.head_repository.full_name"
            }
          }
        }
      }
    ]
  }
]
